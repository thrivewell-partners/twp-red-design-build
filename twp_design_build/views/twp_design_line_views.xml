<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="twp_design_line_view_list" model="ir.ui.view">
        <field name="name">twp.design.line.list</field>
        <field name="model">twp.design.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
            </list>
        </field>
    </record>
    <record id="action_twp_design_line" model="ir.actions.act_window">
        <field name="name">Design lines</field>
        <field name="res_model">twp.design.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
