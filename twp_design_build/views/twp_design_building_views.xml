<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="twp_design_building_opening_view_list" model="ir.ui.view">
        <field name="name">twp.design.building.opening.list</field>
        <field name="model">twp.design.building.opening</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="door_style" invisible="kind != 'door'"/>
                <field name="count"/>
                <field name="width"/>
                <field name="height"/>
                <field name="area" sum="Area"/>
                <field name="insulated" invisible="kind != 'door'"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="twp_design_building_view_form" model="ir.ui.view">
        <field name="name">twp.design.building.form</field>
        <field name="model">twp.design.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_survey" type="object" class="oe_stat_button" icon="fa-list-ol"
                                string="Survey"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Bldg 1"/></h1>
                    </div>
                    <group>
                        <group string="Size and roof" name="size">
                            <field name="lead_id" readonly="id" options="{'no_create': True}"/>
                            <field name="length"/>
                            <field name="width"/>
                            <field name="eave_height"/>
                            <field name="ridge_height" invisible="roof_shape == 'flat'"/>
                            <field name="roof_shape"/>
                        </group>
                        <group string="Works out to" name="sizes">
                            <field name="area"/>
                            <field name="volume"/>
                            <field name="wall_area"/>
                            <field name="roof_area"/>
                            <field name="slab_perimeter"/>
                        </group>
                        <group string="Walls" name="walls">
                            <field name="wall_material"/>
                            <field name="wall_insulation"/>
                            <field name="wall_r_value"/>
                        </group>
                        <group string="Roof" name="roof">
                            <field name="roof_material"/>
                            <field name="roof_insulation"/>
                            <field name="roof_r_value"/>
                        </group>
                    </group>
                    <separator string="Doors and windows"/>
                    <field name="opening_ids"/>
                    <group>
                        <group name="slab">
                            <field name="slab_edge"/>
                        </group>
                        <group name="opening_totals">
                            <field name="door_count"/>
                            <field name="door_area"/>
                            <field name="window_area"/>
                            <field name="skylight_area"/>
                        </group>
                        <group string="Use" name="use">
                            <field name="function"/>
                            <field name="function_other" invisible="function != 'other'"/>
                            <field name="activity"/>
                            <field name="desired_temperature"/>
                            <field name="venting"/>
                        </group>
                        <group string="Drawings" name="drawings">
                            <field name="floor_plan_attachment_ids" widget="many2many_binary"/>
                            <field name="elevation_attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes: obstructions, anything the survey form has no box for"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The survey wizard: the same building, a step at a time, in a dialog. -->
    <record id="twp_design_building_view_form_survey" model="ir.ui.view">
        <field name="name">twp.design.building.form.survey</field>
        <field name="model">twp.design.building</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Building survey">
                <header>
                    <field name="survey_step" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <field name="lead_id" invisible="1"/>
                <div name="step_size" invisible="survey_step != 'size'">
                    <group>
                        <group string="Size">
                            <field name="name" placeholder="Bldg 1"/>
                            <field name="length"/>
                            <field name="width"/>
                            <field name="eave_height"/>
                            <field name="ridge_height" invisible="roof_shape == 'flat'"/>
                        </group>
                        <group string="Roof">
                            <field name="roof_shape" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Works out to">
                            <field name="area"/>
                            <field name="volume"/>
                        </group>
                        <group string="Envelope">
                            <field name="wall_area"/>
                            <field name="roof_area"/>
                            <field name="slab_perimeter"/>
                        </group>
                    </group>
                </div>
                <group name="step_envelope" invisible="survey_step != 'envelope'">
                    <group string="Walls">
                        <field name="wall_material" placeholder="e.g. metal panel"/>
                        <field name="wall_insulation" placeholder="e.g. fiberglass batt"/>
                        <field name="wall_r_value"/>
                    </group>
                    <group string="Roof">
                        <field name="roof_material"/>
                        <field name="roof_insulation"/>
                        <field name="roof_r_value"/>
                    </group>
                </group>
                <div name="step_doors" invisible="survey_step != 'doors'">
                    <p class="text-muted">
                        One row per kind of door or window: overhead, man doors, windows, skylights.
                        Several the same size go on one row with their count.
                    </p>
                    <field name="opening_ids"/>
                    <group>
                        <group string="Slab">
                            <field name="slab_edge" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group string="Totals">
                            <field name="door_count"/>
                            <field name="door_area"/>
                            <field name="window_area"/>
                            <field name="skylight_area"/>
                        </group>
                    </group>
                </div>
                <group name="step_use" invisible="survey_step != 'use'">
                    <group string="Use">
                        <field name="function"/>
                        <field name="function_other" invisible="function != 'other'"/>
                        <field name="activity" placeholder="What goes on inside"/>
                    </group>
                    <group string="Comfort">
                        <field name="desired_temperature"/>
                        <field name="venting" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </group>
                <group name="step_drawings" invisible="survey_step != 'drawings'">
                    <group string="Drawings">
                        <field name="floor_plan_attachment_ids" widget="many2many_binary"/>
                        <field name="elevation_attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Obstructions, anything the survey form has no box for"/>
                    </group>
                </group>
                <!-- Line modules put their results here, e.g. the heat loss, so it is seen before Done. -->
                <div name="step_review" invisible="survey_step != 'review'">
                    <group>
                        <group string="Building">
                            <field name="area" string="Floor area (sq ft)"/>
                            <field name="volume"/>
                            <field name="is_measured"/>
                        </group>
                        <group string="Envelope">
                            <field name="wall_area"/>
                            <field name="roof_area"/>
                            <field name="door_area"/>
                            <field name="window_area"/>
                            <field name="skylight_area"/>
                            <field name="slab_perimeter"/>
                        </group>
                    </group>
                </div>
                <footer>
                    <button name="action_survey_back" string="Back" type="object"
                            invisible="survey_step == 'size'"/>
                    <button name="action_survey_next" string="Next" type="object" class="btn-primary"
                            invisible="survey_step == 'review'"/>
                    <button name="action_survey_done" string="Done" type="object" class="btn-primary"
                            invisible="survey_step != 'review'"/>
                    <button string="Save and close" special="save" class="btn-secondary"
                            invisible="survey_step == 'review'"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="twp_design_building_view_list" model="ir.ui.view">
        <field name="name">twp.design.building.list</field>
        <field name="model">twp.design.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="lead_id"/>
                <field name="name"/>
                <field name="length"/>
                <field name="width"/>
                <field name="eave_height"/>
                <field name="area" sum="Area"/>
                <field name="function" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
