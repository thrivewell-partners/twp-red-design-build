<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="twp_design_job_view_form" model="ir.ui.view">
        <field name="name">twp.design.job.form</field>
        <field name="model">twp.design.job</field>
        <field name="arch" type="xml">
            <form string="Design job" create="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Job" name="job">
                            <field name="active" invisible="1"/>
                            <field name="lead_id" readonly="1"/>
                            <field name="line_id" readonly="1"/>
                            <field name="kind"/>
                            <field name="sizing_basis"/>
                        </group>
                        <group string="Progress" name="progress">
                            <field name="design_done"/>
                            <field name="layout_done"/>
                        </group>
                    </group>
                    <group string="Equipment" name="equipment">
                        <field name="equipment" nolabel="1" colspan="2" placeholder="What the design calls for"/>
                    </group>
                    <group name="layout">
                        <field name="layout_attachment_ids" widget="many2many_binary"/>
                    </group>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="twp_design_job_view_list" model="ir.ui.view">
        <field name="name">twp.design.job.list</field>
        <field name="model">twp.design.job</field>
        <field name="arch" type="xml">
            <list string="Design jobs" create="0">
                <field name="lead_id"/>
                <field name="line_id"/>
                <field name="kind" optional="hide"/>
                <field name="sizing_basis" optional="show"/>
                <field name="design_done"/>
                <field name="layout_done"/>
            </list>
        </field>
    </record>
</odoo>
